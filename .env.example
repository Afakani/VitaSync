# Vorlage fuer .env. Kopieren, dann lokale Werte eintragen:
#   cp .env.example .env
#
# .env ist nicht versioniert (.gitignore). Keine echten Geheimnisse und
# keine Gesundheitsdaten in diese Vorlage schreiben.

# --- Anwendung ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- PostgreSQL (Docker Compose, infra/docker-compose.yml) ---
POSTGRES_USER=vitasync
# Lokal frei waehlbar. Nur fuer die Entwicklungsdatenbank mit synthetischen
# Daten, nie ein Passwort aus einem anderen System wiederverwenden.
POSTGRES_PASSWORD=bitte-lokal-setzen
POSTGRES_DB=vitasync
# Der Dienst wird nur auf 127.0.0.1 veroeffentlicht, nicht im Netz.
# Vorgabe 5433, weil 5432 haeufig von einer lokal installierten PostgreSQL
# belegt ist. Bei Konflikt siehe apps/api/README.md, "Fehlerbehebung: Port
# belegt". POSTGRES_PORT und der Port in DATABASE_URL muessen gleich sein.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://vitasync:bitte-lokal-setzen@127.0.0.1:5433/vitasync

# --- LLM-Laufzeit ---
# Ollama laeuft nativ auf dem Host, nicht als Container (D01, D03).
# Fuer F002 nicht erforderlich.
OLLAMA_BASE_URL=http://127.0.0.1:11434
