# Vorlage fuer .env. Kopieren, dann lokale Werte eintragen:
#   cp .env.example .env
#
# .env ist nicht versioniert (.gitignore). Keine echten Geheimnisse und
# keine Gesundheitsdaten in diese Vorlage schreiben.

# --- Anwendung ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# --- PostgreSQL (Docker Compose, infra/docker-compose.yml) ---
POSTGRES_USER=vitasync
# Lokal frei waehlbar. Nur fuer die Entwicklungsdatenbank mit synthetischen
# Daten, nie ein Passwort aus einem anderen System wiederverwenden.
POSTGRES_PASSWORD=bitte-lokal-setzen
POSTGRES_DB=vitasync
# Der Dienst wird nur auf 127.0.0.1 veroeffentlicht, nicht im Netz.
# Vorgabe 5433, weil 5432 haeufig von einer lokal installierten PostgreSQL
# belegt ist. Bei Konflikt siehe apps/api/README.md, "Fehlerbehebung: Port
# belegt". POSTGRES_PORT und der Port in DATABASE_URL muessen gleich sein.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://vitasync:bitte-lokal-setzen@127.0.0.1:5433/vitasync

# --- LLM-Laufzeit ---
# Ollama laeuft nativ auf dem Host, nicht als Container (Stack, Modell-ADR).
# Nur fuer den Router (features/chat.route_message) noetig.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_TIMEOUT_S=120

# --- Router ---
# CP1-Muster (Teamentwurf, nicht medizinisch geprueft), Pfad relativ zum Repo-Root.
CP1_PATTERNS=knowledge/rules/cp1_patterns.json
# Router-Sicherheitsnetz nach dem Routing (Team-Router v0.5; Name „CP2_“ aus v0.5, nicht die Einwilligungsprüfung CP2).
CP2_PATTERNS=knowledge/rules/cp2_patterns.json
# Erkenner: slm (Embedding + Klassifikator, Tolgas Router v0.5) oder llm.
RECOGNIZER=slm
SLM_WEIGHTS=apps/api/models/slm_lr_qwen3-embedding-8b.json
# Embeddings lokal ueber Ollama (LLM_BASE_URL), vorher: ollama pull qwen3-embedding:8b
EMBED_BACKEND=ollama
EMBED_MODEL=qwen3-embedding:8b
# Nur fuer Tests ueber eine OpenAI-kompatible API (EMBED_BACKEND=api, z. B. KI:connect.nrw,
# EMBED_MODEL=qwen-qwen3-embedding-8b). Nur synthetische Daten. Key nie einchecken, nur in .env.
VITASYNC_API_BASE=
VITASYNC_API_KEY=
# Offene Teamentscheidungen (ADR-0004, VC-84). Leer = vorsichtige Vorgaben.
# Mit RECOGNIZER=slm gilt min_confidence=0.5, solange hier nichts anderes steht.
# Beispiel gelockert: symptom_with_data=allow,symptom_with_tip=allow,condition_named=general_plus_referral
ROUTER_POLICY=
