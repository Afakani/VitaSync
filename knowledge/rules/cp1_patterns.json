    },
    {
      "id": "CR-04",
      "pattern": "nicht mehr aufwach|nie mehr aufwach|fuer immer einschlafen",
      "note": "method / intent phrasing"
    },
    {
      "id": "CR-05",
      "pattern": "(sehr|so|total|extrem) einsam|niemand( \\w+){0,3} (braucht|vermisst) mich|alles( \\w+){0,2} sinnlos",
      "note": "BORDERLINE: loneliness without acute danger (Q144/Q146). Dataset labels it crisis; team decision open"
    }
  ],
  "injection": [
    {
      "id": "IN-01",
      "pattern": "ignorier\\w*|vergiss( \\w+){0,2} (anweisung|regel|richtlinie|vorgabe)",
      "note": "ignore instructions"
    },
    {
      "id": "IN-02",
      "pattern": "system ?-?prompt|(regeln|anweisungen|richtlinien|vorgaben)( \\w+){0,3} (ignorier\\w*|vergiss|vergessen|aufheben|ausschalten|umgehen)|(ohne|keine) (regeln|einschraenkungen|filter)\\b",
      "note": "bypass the bot's rules (a plain 'Was sind deine Regeln?' must NOT trigger)"
    },
    {
      "id": "IN-03",
      "pattern": "tu so,? als (waerst|waeren|seist) (du|sie)|du bist (jetzt|ab sofort|nun) (ein|eine|mein)|spiel( \\w+){0,2} (rolle|arzt|apotheker)|rollenspiel",
      "note": "role play override"
    },
    {
      "id": "IN-04",
      "pattern": "ich erlaube (es )?dir|ausdruecklich erlaubt|ich gebe dir die erlaubnis|du darfst (jetzt|ab sofort)",
      "note": "fake permission"
    },
    {
      "id": "IN-05",
      "pattern": "ignore (all|any|previous|your)|disregard|jailbreak|developer mode|dan mode|act as",
